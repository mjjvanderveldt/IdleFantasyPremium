    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">Imp Grot</string>
    <string name="dungeon_imp_cavern_desc">Een ondiepe grot vol ondeugende Imps. Perfect voor beginners!</string>
    <string name="dungeon_goblin_cave_name">Kobold Grot</string>
    <string name="dungeon_goblin_cave_desc">Een donkere grot vol Kobolden en Megaratten. Een goede plek voor nieuwe avonturiers om te trainen.</string>
    <string name="dungeon_spider_den_name">Spinnenhol</string>
    <string name="dungeon_spider_den_desc">Een met webben gevulde grot vol giftige spinnen. Neem tegengif mee!</string>
    <string name="dungeon_bandit_camp_name">Bandietenkamp</string>
    <string name="dungeon_bandit_camp_desc">Een schuilplaats van dieven en schurken in de wildernis. Pas op je geldbuidel!</string>
    <string name="dungeon_undead_crypt_name">Zombie Crypt</string>
    <string name="dungeon_undead_crypt_desc">Een oude begraafplaats waar de doden weigeren te rusten. Pas op voor de zwarte magie!</string>
    <string name="dungeon_fortress_ruins_name">Kasteel Ruïne</string>
    <string name="dungeon_fortress_ruins_desc">De vervallen resten van een oud kasteel, nu bewaakt door ridders en soldaten.</string>
    <string name="dungeon_orc_stronghold_name">Ork Vesting</string>
    <string name="dungeon_orc_stronghold_desc">Een versterkte nederzetting van Orks, diep in de bergen. Alleen de dappersten wagen zich naar binnen.</string>
    <string name="dungeon_volcanic_depths_name">Vulkanische Diepten</string>
    <string name="dungeon_volcanic_depths_desc">Een vurige grot waar helhonden en mindere demonen huishouden. De hitte is ondraaglijk!</string>
    <string name="dungeon_dragon_lair_name">Drakennest</string>
    <string name="dungeon_dragon_lair_desc">Het legendarische nest van groene draken. Alleen krijgsmeesters overleven deze uitdaging.</string>
    <string name="dungeon_farm_name">Boerderij</string>
    <string name="dungeon_farm_desc">Een rustige boerderij met vee. Geweldig voor beginners die voedsel willen verzamelen!</string>
    <string name="dungeon_infernal_stronghold_name">Helse Vesting</string>
    <string name="dungeon_infernal_stronghold_desc">Een fort van vuur en zwavel. Demonen en Helhonden voeren hier het bevel. De hitte alleen al kan hen die niet voorbereid zijn doden.</string>
    <string name="dungeon_ancient_temple_name">Eeuwenoude Tempel</string>
    <string name="dungeon_ancient_temple_desc">Een eeuwenoude tempel, bewaakt door de machtigste wezens van het Domein. Alleen de sterksten wagen zich naar binnen.</string>
    <string name="dungeon_void_rift_name">Leegtekloof</string>
    <string name="dungeon_void_rift_desc">Een scheur in de werkelijkheid waar leegtewezens de sterfelijke wereld binnendringen.</string>
    <string name="dungeon_frozen_citadel_name">Bevroren Citadel</string>
    <string name="dungeon_frozen_citadel_desc">Een eeuwenoude vesting opgesloten in een gletsjer, met verdedigers bevroren in eeuwige wacht.</string>
    <string name="dungeon_abyssal_throne_name">Afgrondstroon</string>
    <string name="dungeon_abyssal_throne_desc">Het diepste punt van de bekende wereld, geregeerd door leegteheren sinds het begin der tijden.</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">The Sunspire</string> <!-- untranslated -->
    <string name="dungeon_sunspire_desc">A sun-tower ruin cracked open by the solstice, spilling heat spirits into the region. Part of the Sunspire Solstice event.</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_name">The Hollowfen</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_desc">A mist-drowned marsh of sunken barrows where the harvest dead walk. Part of the Gloomharvest event.</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_name">Cloud Kingdom</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_desc">A realm above the clouds, reached by climbing a legendary beanstalk. Giants roam vast floating islands, sky serpents drift between the cloudbanks, and storm imps crackle with restless energy. Few have seen it. Fewer still have returned to speak of it.</string> <!-- untranslated -->
    <string name="dungeon_blightwood_name">The Blightwood</string> <!-- untranslated -->
    <string name="dungeon_blightwood_desc">A rotting forest deep past the Hollowfen, where the Gloomharvest\'s strongest horrors gather. Part of the Gloomharvest event.</string> <!-- untranslated -->

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">Koning der Zwarte Draken</string>
    <string name="boss_king_black_dragon_desc">De legendarische driekoppige draak, gevreesd in het hele rijk.</string>
    <string name="boss_demon_lord_name">Demonenheer</string>
    <string name="boss_demon_lord_desc">Een oeroude demon uit de afgrond, meester van duistere magie.</string>
    <string name="boss_kraken_name">Kraken</string> <!-- untranslated -->
    <string name="boss_kraken_desc">De schrik van de diepzee, een kolossaal zeemonster.</string>
    <string name="boss_balrog_name">Gothic Ember</string> <!-- untranslated -->
    <string name="boss_balrog_desc">Een oeroude demon van vlam en schaduw, ontwaakt uit zijn sluimer diep onder de aarde.</string>
    <string name="boss_void_sovereign_name">The Void Sovereign</string> <!-- untranslated -->
    <string name="boss_void_sovereign_desc">De oorspronkelijke entiteit achter de leemtescheuren. Onmetelijk oud, bekijkt sterfelijke uitdagers met minachting.</string>
    <string name="boss_sol_invictus_name">Sol Invictus, the Sundered Flame</string> <!-- untranslated -->
    <string name="boss_sol_invictus_desc">A shard of the sun itself, torn loose from the Sunspire ruin. Only the boldest warriors dare approach.</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_name">The Hollow King</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_desc">The headless sovereign of the Gloomharvest, riding out from the Blightwood to reap what the living have sown.</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_name">The Vault Guardian</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_desc">A colossus of living gold, woken by the lighting of the Eternal Flame. Only patrons of the Grand Monument may face it.</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_name">Obsidian Colossus</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_desc">A mountain given wrath. No lone hero has ever chipped more than a scar into it. Bring a party.</string> <!-- untranslated -->
    <string name="boss_brood_empress_name">Brood Empress</string> <!-- untranslated -->
    <string name="boss_brood_empress_desc">Mother of the swarm between the stars. Her brood has ended armies; yours had better be paid well.</string> <!-- untranslated -->
    <string name="boss_the_world_ender_name">The World Ender</string> <!-- untranslated -->
    <string name="boss_the_world_ender_desc">When it stirs, kingdoms write their wills. Four names on the contract or none return.</string> <!-- untranslated -->

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">Ingestorte Mijn</string>
    <string name="dungeon_collapsed_mine_desc">Een uitgestrekte grot onder de kopermijnen. Holtrollen en steengolems spoken door het puin, en reusachtige spinnen weven webben door de ingestorte schachten.</string>
    <string name="dungeon_shadow_den_name">Schaduwschuilplaats</string>
    <string name="dungeon_shadow_den_desc">Een netwerk van ondergrondse kamers gebruikt door het dievengilde van de regio. Schurken, huurmoordenaars en schaduwwezens loeren in elke hoek.</string>
    <string name="dungeon_abyssal_ruins_name">Afgrondelijke Ruïnes</string>
    <string name="dungeon_abyssal_ruins_desc">Oude ruïnes die tegelijkertijd boven en onder het sterfelijke vlak bestaan. Vreemde afgrondelijke wezens verschijnen en verdwijnen uit de realiteit.</string>
    <string name="dungeon_ancient_forest_ruins_name">Oude Bosruïnes</string>
    <string name="dungeon_ancient_forest_ruins_desc">Stenen ruïnes die zijn opgeslokt door het oerbos, nu achtervolgd door wilde wezens en wraakzuchtige geesten van druïden.</string>
    <string name="dungeon_ancient_forge_name">Oud Smeedwerk</string>
    <string name="dungeon_ancient_forge_desc">Een uitgestrekte dwergensmederij die al eeuwen ononderbroken brandt. Vuurelementen en smeedwachters beschermen haar geheimen.</string>
    <string name="dungeon_arcane_ruins_name">Arcane Ruïnes</string>
    <string name="dungeon_arcane_ruins_desc">De functionele ondergrondse kamers van een vernietigde tovenarstoren. Magische constructies en betoverde wachters patrouilleren nog steeds door de gangen.</string>
    <string name="dungeon_corrupted_sanctum_name">Verdorven Heiligdom</string>
    <string name="dungeon_corrupted_sanctum_desc">Een schaduwgedrenkt heiligdom in het hart van het verdorven bladerdak. Donkere priesters en verdorven beesten bewaken een oud kwaad.</string>
    <string name="dungeon_drowned_temple_name">Verdronken Tempel</string>
    <string name="dungeon_drowned_temple_desc">Een gezonken tempel onder de zeegrot, met gangen vol water en zeewezens die er hun thuis van hebben gemaakt.</string>
    <string name="dungeon_rogue_sanctum_name">Schurkentoevluchtsoord</string>
    <string name="dungeon_rogue_sanctum_desc">Het innerlijke toevluchtsoord van het gilde, alleen toegankelijk voor bewezen leden.</string>
    <string name="dungeon_guild_of_shadows_name">Schaduwgilde</string>
    <string name="dungeon_guild_of_shadows_desc">Het diepste heiligdom van het dievensgilde, bewaakt door zijn gevaarlijkste handhavers.</string>

