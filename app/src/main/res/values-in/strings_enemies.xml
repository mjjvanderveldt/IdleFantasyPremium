    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">Gua Setan Kerdil</string>
    <string name="dungeon_imp_cavern_desc">Gua dangkal yang dipenuhi setan kerdil usil. Cocok untuk pemula sejati!</string>
    <string name="dungeon_goblin_cave_name">Gua Goblin</string>
    <string name="dungeon_goblin_cave_desc">Gua gelap yang dipenuhi goblin dan tikus raksasa. Tempat yang bagus bagi para petualang baru untuk berlatih.</string>
    <string name="dungeon_spider_den_name">Sarang Laba-laba</string>
    <string name="dungeon_spider_den_desc">Gua yang dipenuhi jaring laba-laba beracun. Bawalah penawar racun!</string>
    <string name="dungeon_bandit_camp_name">Kamp Bandit</string>
    <string name="dungeon_bandit_camp_desc">Persembunyian para pencuri dan berandal di alam liar. Jaga baik-baik kantong koinmu!</string>
    <string name="dungeon_undead_crypt_name">Makam Mayat Hidup</string>
    <string name="dungeon_undead_crypt_desc">Tempat pemakaman kuno di mana para mayat menolak untuk beristirahat. Waspadalah terhadap sihir kegelapan!</string>
    <string name="dungeon_fortress_ruins_name">Reruntuhan Benteng</string>
    <string name="dungeon_fortress_ruins_desc">Puing-puing kastil kuno yang runtuh, kini dijaga oleh para ksatria dan prajurit.</string>
    <string name="dungeon_orc_stronghold_name">Benteng Orc</string>
    <string name="dungeon_orc_stronghold_desc">Permukiman orc yang dibentengi jauh di pegunungan. Hanya para pemberani yang berani memasukinya.</string>
    <string name="dungeon_volcanic_depths_name">Kedalaman Vulkanik</string>
    <string name="dungeon_volcanic_depths_desc">Gua yang membara, dihuni oleh anjing neraka dan iblis kecil. Panasnya tak tertahankan!</string>
    <string name="dungeon_dragon_lair_name">Sarang Naga</string>
    <string name="dungeon_dragon_lair_desc">Rumah legendaris para naga hijau. Hanya pejuang ulung yang mampu bertahan dari tantangan ini.</string>
    <string name="dungeon_farm_name">Peternakan</string>
    <string name="dungeon_farm_desc">Peternakan yang damai dengan hewan ternak. Cocok bagi pemula yang ingin mengumpulkan makanan!</string>
    <string name="dungeon_infernal_stronghold_name">Benteng Neraka</string>
    <string name="dungeon_infernal_stronghold_desc">Benteng api dan belerang, dikuasai oleh iblis dan anjing neraka. Panasnya saja sudah cukup untuk membunuh mereka yang tak siap.</string>
    <string name="dungeon_ancient_temple_name">Kuil Kuno</string>
    <string name="dungeon_ancient_temple_desc">Kuil kuno yang dijaga oleh makhluk-makhluk terkuat di seluruh negeri. Hanya pejuang terkuat yang berani memasukinya.</string>
    <string name="dungeon_void_rift_name">Robekan Void</string>
    <string name="dungeon_void_rift_desc">Sebuah robekan di realitas tempat makhluk-makhluk hampa masuk ke dunia fana.</string>
    <string name="dungeon_frozen_citadel_name">Citadel Beku</string>
    <string name="dungeon_frozen_citadel_desc">Sebuah benteng kuno yang diselimuti gletser, para pembelanya membeku dalam penjagaan abadi.</string>
    <string name="dungeon_abyssal_throne_name">Takhta Abyssal</string>
    <string name="dungeon_abyssal_throne_desc">Titik terdalam di dunia yang dikenal, diperintah oleh penguasa kehampaan sejak awal waktu.</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">The Sunspire</string> <!-- untranslated -->
    <string name="dungeon_sunspire_desc">A sun-tower ruin cracked open by the solstice, spilling heat spirits into the region. Part of the Sunspire Solstice event.</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_name">The Hollowfen</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_desc">A mist-drowned marsh of sunken barrows where the harvest dead walk. Part of the Gloomharvest event.</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_name">Cloud Kingdom</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_desc">A realm above the clouds, reached by climbing a legendary beanstalk. Giants roam vast floating islands, sky serpents drift between the cloudbanks, and storm imps crackle with restless energy. Few have seen it. Fewer still have returned to speak of it.</string> <!-- untranslated -->
    <string name="dungeon_blightwood_name">The Blightwood</string> <!-- untranslated -->
    <string name="dungeon_blightwood_desc">A rotting forest deep past the Hollowfen, where the Gloomharvest\'s strongest horrors gather. Part of the Gloomharvest event.</string> <!-- untranslated -->

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">Raja Naga Hitam</string>
    <string name="boss_king_black_dragon_desc">Naga berkepala tiga yang legendaris, ditakuti di seluruh alam.</string>
    <string name="boss_demon_lord_name">Penguasa Iblis</string>
    <string name="boss_demon_lord_desc">Sesosok iblis kuno dari jurang maut, penguasa sihir gelap.</string>
    <string name="boss_kraken_name">Kraken</string> <!-- untranslated -->
    <string name="boss_kraken_desc">Teror laut dalam, monster laut raksasa.</string>
    <string name="boss_balrog_name">Gothic Ember</string> <!-- untranslated -->
    <string name="boss_balrog_desc">Sesosok iblis kuno api dan bayangan, terbangun dari tidurnya jauh di bawah bumi.</string>
    <string name="boss_void_sovereign_name">Penguasa Hampa</string>
    <string name="boss_void_sovereign_desc">Entitas primordial di balik robekan void. Kuno melampaui segala perhitungan, ia memandang para penantang fana dengan penghinaan.</string>
    <string name="boss_sol_invictus_name">Sol Invictus, the Sundered Flame</string> <!-- untranslated -->
    <string name="boss_sol_invictus_desc">A shard of the sun itself, torn loose from the Sunspire ruin. Only the boldest warriors dare approach.</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_name">The Hollow King</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_desc">The headless sovereign of the Gloomharvest, riding out from the Blightwood to reap what the living have sown.</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_name">The Vault Guardian</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_desc">A colossus of living gold, woken by the lighting of the Eternal Flame. Only patrons of the Grand Monument may face it.</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_name">Obsidian Colossus</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_desc">A mountain given wrath. No lone hero has ever chipped more than a scar into it. Bring a party.</string> <!-- untranslated -->
    <string name="boss_brood_empress_name">Brood Empress</string> <!-- untranslated -->
    <string name="boss_brood_empress_desc">Mother of the swarm between the stars. Her brood has ended armies; yours had better be paid well.</string> <!-- untranslated -->
    <string name="boss_the_world_ender_name">The World Ender</string> <!-- untranslated -->
    <string name="boss_the_world_ender_desc">When it stirs, kingdoms write their wills. Four names on the contract or none return.</string> <!-- untranslated -->

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">Tambang Runtuh</string>
    <string name="dungeon_collapsed_mine_desc">Gua luas di bawah tambang tembaga. Troll gua dan golem batu menghantui reruntuhannya, sementara laba-laba raksasa menenun jaring di poros-poros yang runtuh.</string>
    <string name="dungeon_shadow_den_name">Sarang Bayangan</string>
    <string name="dungeon_shadow_den_desc">Jaringan ruang bawah tanah yang digunakan oleh serikat pencuri di wilayah ini. Berandal, pembunuh bayaran, dan makhluk bayangan mengintai di setiap sudut.</string>
    <string name="dungeon_abyssal_ruins_name">Reruntuhan Jurang</string>
    <string name="dungeon_abyssal_ruins_desc">Reruntuhan kuno yang ada secara bersamaan di atas dan di bawah alam fana. Makhluk-makhluk jurang yang aneh muncul dan menghilang dari kenyataan.</string>
    <string name="dungeon_ancient_forest_ruins_name">Reruntuhan Hutan Kuno</string>
    <string name="dungeon_ancient_forest_ruins_desc">Reruntuhan batu yang ditelan hutan purba, kini dihantui oleh makhluk liar dan arwah pendendam para druid.</string>
    <string name="dungeon_ancient_forge_name">Tungku Kuno</string>
    <string name="dungeon_ancient_forge_desc">Tungku kurcaci yang luas dan telah membara selama berabad-abad tanpa henti. Elemental api dan penjaga tungku melindungi rahasianya.</string>
    <string name="dungeon_arcane_ruins_name">Reruntuhan Arkana</string>
    <string name="dungeon_arcane_ruins_desc">Ruang bawah tanah yang masih berfungsi dari menara penyihir yang telah hancur. Konstruksi magis dan penjaga tersihir masih berpatroli di lorong-lorongnya.</string>
    <string name="dungeon_corrupted_sanctum_name">Tempat Suci Terkorupsi</string>
    <string name="dungeon_corrupted_sanctum_desc">Tempat suci yang diselimuti bayangan di jantung kanopi yang terkorupsi. Pendeta kegelapan dan makhluk buas yang terkorupsi menjaga kejahatan kuno.</string>
    <string name="dungeon_drowned_temple_name">Kuil Tenggelam</string>
    <string name="dungeon_drowned_temple_desc">Kuil yang tenggelam di bawah gua laut, lorong-lorongnya dipenuhi air dan makhluk laut yang telah menjadikannya rumah.</string>
    <string name="dungeon_rogue_sanctum_name">Rogue Sanctum</string> <!-- untranslated -->
    <string name="dungeon_rogue_sanctum_desc">Tempat perlindungan dalam serikat, hanya untuk anggota yang terbukti.</string>
    <string name="dungeon_guild_of_shadows_name">Serikat Bayangan</string>
    <string name="dungeon_guild_of_shadows_desc">Ruang paling rahasia dari perkumpulan pencuri, dijaga oleh para penegak hukum paling elitnya.</string>

