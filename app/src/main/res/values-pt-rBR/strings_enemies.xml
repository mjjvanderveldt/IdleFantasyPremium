    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">Caverna dos Diabretes</string>
    <string name="dungeon_imp_cavern_desc">Uma caverna rasa cheia de diabretes travessos. Perfeita para iniciantes completos!</string>
    <string name="dungeon_goblin_cave_name">Caverna dos Goblins</string>
    <string name="dungeon_goblin_cave_desc">Uma caverna escura infestada de goblins e ratos gigantes. Um bom lugar para novos aventureiros treinarem.</string>
    <string name="dungeon_spider_den_name">Covil das Aranhas</string>
    <string name="dungeon_spider_den_desc">Uma caverna cheia de teias, repleta de aranhas venenosas. Traga antídoto!</string>
    <string name="dungeon_bandit_camp_name">Acampamento de Bandidos</string>
    <string name="dungeon_bandit_camp_desc">Um esconderijo de ladrões e ladinos na natureza selvagem. Cuide bem da sua bolsa de moedas!</string>
    <string name="dungeon_undead_crypt_name">Cripta dos Mortos-Vivos</string>
    <string name="dungeon_undead_crypt_desc">Um antigo cemitério onde os mortos se recusam a descansar. Cuidado com a magia sombria!</string>
    <string name="dungeon_fortress_ruins_name">Ruínas da Fortaleza</string>
    <string name="dungeon_fortress_ruins_desc">Os destroços de um antigo castelo, agora guardados por cavaleiros e soldados.</string>
    <string name="dungeon_orc_stronghold_name">Fortaleza Orc</string>
    <string name="dungeon_orc_stronghold_desc">Um assentamento orc fortificado nas profundezas das montanhas. Somente os corajosos ousam entrar.</string>
    <string name="dungeon_volcanic_depths_name">Profundezas Vulcânicas</string>
    <string name="dungeon_volcanic_depths_desc">Uma caverna escaldante habitada por cães do inferno e demônios menores. O calor é insuportável!</string>
    <string name="dungeon_dragon_lair_name">Covil do Dragão</string>
    <string name="dungeon_dragon_lair_desc">O lendário lar dos dragões verdes. Somente guerreiros mestres sobrevivem a este desafio.</string>
    <string name="dungeon_farm_name">Fazenda</string>
    <string name="dungeon_farm_desc">Uma fazenda tranquila com animais. Ótima para iniciantes que buscam coletar comida!</string>
    <string name="dungeon_infernal_stronghold_name">Fortaleza Infernal</string>
    <string name="dungeon_infernal_stronghold_desc">Uma fortaleza de fogo e enxofre, governada por demônios e cães do inferno. Só o calor já é capaz de matar os despreparados.</string>
    <string name="dungeon_ancient_temple_name">Templo Antigo</string>
    <string name="dungeon_ancient_temple_desc">Um templo antigo guardado pelas criaturas mais poderosas do reino. Somente os guerreiros mais fortes ousam entrar.</string>
    <string name="dungeon_void_rift_name">Fenda do Vazio</string>
    <string name="dungeon_void_rift_desc">Uma fenda na realidade por onde criaturas do vazio invadem o mundo mortal.</string>
    <string name="dungeon_frozen_citadel_name">Cidadela Congelada</string>
    <string name="dungeon_frozen_citadel_desc">Uma fortaleza antiga presa em uma geleira, seus defensores congelados em vigília eterna.</string>
    <string name="dungeon_abyssal_throne_name">Trono Abissal</string>
    <string name="dungeon_abyssal_throne_desc">O ponto mais profundo do mundo conhecido, governado por senhores do vazio desde o início dos tempos.</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">The Sunspire</string> <!-- untranslated -->
    <string name="dungeon_sunspire_desc">A sun-tower ruin cracked open by the solstice, spilling heat spirits into the region. Part of the Sunspire Solstice event.</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_name">The Hollowfen</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_desc">A mist-drowned marsh of sunken barrows where the harvest dead walk. Part of the Gloomharvest event.</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_name">Cloud Kingdom</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_desc">A realm above the clouds, reached by climbing a legendary beanstalk. Giants roam vast floating islands, sky serpents drift between the cloudbanks, and storm imps crackle with restless energy. Few have seen it. Fewer still have returned to speak of it.</string> <!-- untranslated -->
    <string name="dungeon_blightwood_name">The Blightwood</string> <!-- untranslated -->
    <string name="dungeon_blightwood_desc">A rotting forest deep past the Hollowfen, where the Gloomharvest\'s strongest horrors gather. Part of the Gloomharvest event.</string> <!-- untranslated -->

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">Rei Dragão Negro</string>
    <string name="boss_king_black_dragon_desc">O legendário dragão de três cabeças, temido em todo o reino.</string>
    <string name="boss_demon_lord_name">Senhor dos Demônios</string>
    <string name="boss_demon_lord_desc">Um demônio ancestral do abismo, mestre da magia sombria.</string>
    <string name="boss_kraken_name">Kraken</string> <!-- untranslated -->
    <string name="boss_kraken_desc">O terror dos mares profundos, um monstro marinho colossal.</string>
    <string name="boss_balrog_name">Gothic Ember</string> <!-- untranslated -->
    <string name="boss_balrog_desc">Um demônio ancestral de chamas e sombras, despertado de seu sono nas profundezas da terra.</string>
    <string name="boss_void_sovereign_name">O Soberano do Vazio</string>
    <string name="boss_void_sovereign_desc">A entidade primordial por trás das fendas do vazio. Ancestral além da compreensão, ela trata os desafiantes mortais com desprezo.</string>
    <string name="boss_sol_invictus_name">Sol Invictus, the Sundered Flame</string> <!-- untranslated -->
    <string name="boss_sol_invictus_desc">A shard of the sun itself, torn loose from the Sunspire ruin. Only the boldest warriors dare approach.</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_name">The Hollow King</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_desc">The headless sovereign of the Gloomharvest, riding out from the Blightwood to reap what the living have sown.</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_name">The Vault Guardian</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_desc">A colossus of living gold, woken by the lighting of the Eternal Flame. Only patrons of the Grand Monument may face it.</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_name">Obsidian Colossus</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_desc">A mountain given wrath. No lone hero has ever chipped more than a scar into it. Bring a party.</string> <!-- untranslated -->
    <string name="boss_brood_empress_name">Brood Empress</string> <!-- untranslated -->
    <string name="boss_brood_empress_desc">Mother of the swarm between the stars. Her brood has ended armies; yours had better be paid well.</string> <!-- untranslated -->
    <string name="boss_the_world_ender_name">The World Ender</string> <!-- untranslated -->
    <string name="boss_the_world_ender_desc">When it stirs, kingdoms write their wills. Four names on the contract or none return.</string> <!-- untranslated -->

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">Mina Desmoronada</string>
    <string name="dungeon_collapsed_mine_desc">Uma vasta caverna sob as minas de cobre. Trolls das cavernas e golens de pedra assombram os escombros, enquanto aranhas gigantes tecem teias pelos poços desmoronados.</string>
    <string name="dungeon_shadow_den_name">Covil das Sombras</string>
    <string name="dungeon_shadow_den_desc">Uma rede de câmaras subterrâneas usada pela guilda de ladrões da região. Ladinos, assassinos e criaturas sombrias espreitam em cada canto.</string>
    <string name="dungeon_abyssal_ruins_name">Ruínas Abissais</string>
    <string name="dungeon_abyssal_ruins_desc">Ruínas antigas que existem simultaneamente acima e abaixo do plano mortal. Estranhas criaturas abissais surgem e desaparecem da realidade.</string>
    <string name="dungeon_ancient_forest_ruins_name">Ruínas da Floresta Antiga</string>
    <string name="dungeon_ancient_forest_ruins_desc">Ruínas de pedra engolidas pela floresta primitiva, agora assombradas por criaturas selvagens e espíritos vingativos de druidas.</string>
    <string name="dungeon_ancient_forge_name">Forja Antiga</string>
    <string name="dungeon_ancient_forge_desc">Uma vasta forja anã que arde sem parar há séculos. Elementais de fogo e guardiões da forja protegem seus segredos.</string>
    <string name="dungeon_arcane_ruins_name">Ruínas Arcanas</string>
    <string name="dungeon_arcane_ruins_desc">As câmaras subterrâneas ainda funcionais da torre destruída de um mago. Constructos mágicos e guardiões encantados ainda patrulham seus corredores.</string>
    <string name="dungeon_corrupted_sanctum_name">Santuário Corrompido</string>
    <string name="dungeon_corrupted_sanctum_desc">Um santuário encharcado de sombras no coração do dossel corrompido. Sacerdotes sombrios e bestas corrompidas guardam um mal ancestral.</string>
    <string name="dungeon_drowned_temple_name">Templo Afogado</string>
    <string name="dungeon_drowned_temple_desc">Um templo submerso sob a gruta marinha, seus corredores cheios de água e criaturas marinhas que fizeram dele o seu lar.</string>
    <string name="dungeon_rogue_sanctum_name">Santuário dos Vigaristas</string>
    <string name="dungeon_rogue_sanctum_desc">O refúgio interno da guilda, acessível apenas a membros comprovados.</string>
    <string name="dungeon_guild_of_shadows_name">Guilda das Sombras</string>
    <string name="dungeon_guild_of_shadows_desc">O santuário mais interno da guilda dos ladrões, guardado por seus capangas mais elite.</string>

