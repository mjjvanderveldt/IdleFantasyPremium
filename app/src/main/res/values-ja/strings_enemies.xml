    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">インプの洞窟</string>
    <string name="dungeon_imp_cavern_desc">いたずら好きなインプでいっぱいの浅い洞窟。初心者に最適です！</string>
    <string name="dungeon_goblin_cave_name">ゴブリンの洞窟</string>
    <string name="dungeon_goblin_cave_desc">ゴブリンと巨大ネズミがはびこる暗い洞窟。駆け出しの冒険者が訓練するのに適した場所です。</string>
    <string name="dungeon_spider_den_name">クモの巣窟</string>
    <string name="dungeon_spider_den_desc">毒グモが這い回る、蜘蛛の巣に覆われた洞窟。解毒薬を持参してください！</string>
    <string name="dungeon_bandit_camp_name">山賊のキャンプ</string>
    <string name="dungeon_bandit_camp_desc">荒野にある泥棒やならず者たちの隠れ家。財布を盗まれないよう気をつけましょう！</string>
    <string name="dungeon_undead_crypt_name">不死者の地下墓地</string>
    <string name="dungeon_undead_crypt_desc">死者が眠ることを拒む古代の埋葬地。闇の魔法に注意してください！</string>
    <string name="dungeon_fortress_ruins_name">要塞の廃墟</string>
    <string name="dungeon_fortress_ruins_desc">古代の城の崩れかけた遺跡。現在は騎士や兵士たちによって守られています。</string>
    <string name="dungeon_orc_stronghold_name">オークの砦</string>
    <string name="dungeon_orc_stronghold_desc">山の奥深くにある要塞化されたオークの集落。勇敢な者だけが立ち入ることを許されます。</string>
    <string name="dungeon_volcanic_depths_name">火山深部</string>
    <string name="dungeon_volcanic_depths_desc">ヘルハウンドやレッサーデーモンが生息する、焼けつくような洞窟。耐えがたいほどの暑さです！</string>
    <string name="dungeon_dragon_lair_name">竜の巣</string>
    <string name="dungeon_dragon_lair_desc">グリーンドラゴンの伝説的な住処。熟練の戦士だけがこの試練を生き延びることができます。</string>
    <string name="dungeon_farm_name">農場</string>
    <string name="dungeon_farm_desc">家畜のいる平和な農場。食料を集めたい初心者に最適です！</string>
    <string name="dungeon_infernal_stronghold_name">地獄の要塞</string>
    <string name="dungeon_infernal_stronghold_desc">デーモンとヘルハウンドが支配する、炎と硫黄の要塞。十分な準備がない者は、その暑さだけで命を落とすでしょう。</string>
    <string name="dungeon_ancient_temple_name">古代の神殿</string>
    <string name="dungeon_ancient_temple_desc">この世で最も強力なクリーチャーたちによって守られている古代の神殿。最強の戦士だけが立ち入る勇気を持ちます。</string>
    <string name="dungeon_void_rift_name">ヴォイドリフト</string>
    <string name="dungeon_void_rift_desc">現実世界の裂け目。ここからヴォイドの怪物たちが人間界へと流れ込んでいます。</string>
    <string name="dungeon_frozen_citadel_name">凍てついた砦</string>
    <string name="dungeon_frozen_citadel_desc">氷河に閉ざされた古代の要塞。その守護者たちは永遠の監視のなかで凍りついています。</string>
    <string name="dungeon_abyssal_throne_name">アビサルスローン</string>
    <string name="dungeon_abyssal_throne_desc">既知の世界の最深部。天地創造の黎明期よりヴォイドロードたちによって支配されています。</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">The Sunspire</string> <!-- untranslated -->
    <string name="dungeon_sunspire_desc">A sun-tower ruin cracked open by the solstice, spilling heat spirits into the region. Part of the Sunspire Solstice event.</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_name">The Hollowfen</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_desc">A mist-drowned marsh of sunken barrows where the harvest dead walk. Part of the Gloomharvest event.</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_name">Cloud Kingdom</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_desc">A realm above the clouds, reached by climbing a legendary beanstalk. Giants roam vast floating islands, sky serpents drift between the cloudbanks, and storm imps crackle with restless energy. Few have seen it. Fewer still have returned to speak of it.</string> <!-- untranslated -->
    <string name="dungeon_blightwood_name">The Blightwood</string> <!-- untranslated -->
    <string name="dungeon_blightwood_desc">A rotting forest deep past the Hollowfen, where the Gloomharvest\'s strongest horrors gather. Part of the Gloomharvest event.</string> <!-- untranslated -->

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">キングブラックドラゴン</string>
    <string name="boss_king_black_dragon_desc">世界中で恐れられている、伝説の三つ頭のドラゴン。</string>
    <string name="boss_demon_lord_name">魔王</string>
    <string name="boss_demon_lord_desc">深淵から現れた古代の悪魔。暗黒魔法の使い手。</string>
    <string name="boss_kraken_name">クラーケン</string>
    <string name="boss_kraken_desc">深海の恐怖。巨大な海の怪物。</string>
    <string name="boss_balrog_name">Gothic Ember</string> <!-- untranslated -->
    <string name="boss_balrog_desc">地中深くの眠りから目覚めた、炎と影をまとう古代の悪魔。</string>
    <string name="boss_void_sovereign_name" translatable="false">ヴォイド・ソブリン</string>
    <string name="boss_void_sovereign_desc">ヴォイドリフトの背後に存在する始原の存在。計り知れない歳月を生きており、挑んでくる凡百の冒険者を軽蔑しています。</string>
    <string name="boss_sol_invictus_name">Sol Invictus, the Sundered Flame</string> <!-- untranslated -->
    <string name="boss_sol_invictus_desc">A shard of the sun itself, torn loose from the Sunspire ruin. Only the boldest warriors dare approach.</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_name">The Hollow King</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_desc">The headless sovereign of the Gloomharvest, riding out from the Blightwood to reap what the living have sown.</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_name">The Vault Guardian</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_desc">A colossus of living gold, woken by the lighting of the Eternal Flame. Only patrons of the Grand Monument may face it.</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_name">Obsidian Colossus</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_desc">A mountain given wrath. No lone hero has ever chipped more than a scar into it. Bring a party.</string> <!-- untranslated -->
    <string name="boss_brood_empress_name">Brood Empress</string> <!-- untranslated -->
    <string name="boss_brood_empress_desc">Mother of the swarm between the stars. Her brood has ended armies; yours had better be paid well.</string> <!-- untranslated -->
    <string name="boss_the_world_ender_name">The World Ender</string> <!-- untranslated -->
    <string name="boss_the_world_ender_desc">When it stirs, kingdoms write their wills. Four names on the contract or none return.</string> <!-- untranslated -->

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">崩落した鉱山</string>
    <string name="dungeon_collapsed_mine_desc">銅鉱山の地下に広がる巨大な空洞。がれきには洞窟トロールやロックゴーレムが巣食い、崩落したシャフトには巨大グモが巣を張っています。</string>
    <string name="dungeon_shadow_den_name">影の巣窟</string>
    <string name="dungeon_shadow_den_desc">地域のシーフギルドによって使用されている地下室のネットワーク。ならず者、暗殺者、そして影の怪物がいたる所に潜んでいます。</string>
    <string name="dungeon_abyssal_ruins_name">深淵の遺跡</string>
    <string name="dungeon_abyssal_ruins_desc">人間界の上と下の両方に同時に存在する古代の遺跡。奇妙な深淵のクリーチャーが現実世界に出没します。</string>
    <string name="dungeon_ancient_forest_ruins_name">古代の森の遺跡</string>
    <string name="dungeon_ancient_forest_ruins_desc">原始の森に飲み込まれた石造りの遺跡。現在は野生のクリーチャーやドルイドの復讐心に満ちた精霊が巣食っています。</string>
    <string name="dungeon_ancient_forge_name">古代の鍛冶場</string>
    <string name="dungeon_ancient_forge_desc">何世紀にもわたって絶えることなく燃え続けている巨大なドワーフの鍛冶場。炎のエレメンタルと鍛冶場の守護者がその秘密を守っています。</string>
    <string name="dungeon_arcane_ruins_name">アルケインの遺跡</string>
    <string name="dungeon_arcane_ruins_desc">破壊された魔術師の塔の機能的な地下室。魔法のゴーレムやエンチャントされた守護者が今も通路を巡回しています。</string>
    <string name="dungeon_corrupted_sanctum_name">堕落した聖域</string>
    <string name="dungeon_corrupted_sanctum_desc">堕落した樹冠の中心にある、影に包まれた聖域。闇の司祭と堕落した獣が古代の邪悪を守っています。</string>
    <string name="dungeon_drowned_temple_name">水没した神殿</string>
    <string name="dungeon_drowned_temple_desc">海の洞窟の下にある沈没した神殿。その広間は水で満たされ、そこを住処とする海の生物で溢れています。</string>
    <string name="dungeon_rogue_sanctum_name">ローグサンクタム</string>
    <string name="dungeon_rogue_sanctum_desc">実力を証明したメンバーのみが立ち入りを許される、盗賊ギルドの隠れ家。</string>
    <string name="dungeon_guild_of_shadows_name">シャドウギルド</string>
    <string name="dungeon_guild_of_shadows_desc">盗賊ギルドの最深部。精鋭の護衛たちによって守られています。</string>

