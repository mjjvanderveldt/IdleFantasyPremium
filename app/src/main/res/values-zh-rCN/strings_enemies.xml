    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">小鬼洞穴</string>
    <string name="dungeon_imp_cavern_desc">一个满是淘气小鬼的浅洞穴。非常适合新手入门！</string>
    <string name="dungeon_goblin_cave_name">哥布林洞穴</string>
    <string name="dungeon_goblin_cave_desc">一个被哥布林和巨鼠占据的黑暗洞穴。新冒险者练级的好去处。</string>
    <string name="dungeon_spider_den_name">蜘蛛巢穴</string>
    <string name="dungeon_spider_den_desc">一个蛛网密布、毒蜘蛛横行的洞穴。记得带解毒药！</string>
    <string name="dungeon_bandit_camp_name">强盗营地</string>
    <string name="dungeon_bandit_camp_desc">荒野中盗贼和流氓的藏身之处。看好你的钱袋！</string>
    <string name="dungeon_undead_crypt_name">亡灵地穴</string>
    <string name="dungeon_undead_crypt_desc">亡者拒绝安息的古老墓地。小心暗黑魔法！</string>
    <string name="dungeon_fortress_ruins_name">要塞废墟</string>
    <string name="dungeon_fortress_ruins_desc">一座古老城堡的残垣断壁，如今由骑士和士兵把守。</string>
    <string name="dungeon_orc_stronghold_name">兽人堡垒</string>
    <string name="dungeon_orc_stronghold_desc">深山中一座坚固的兽人营地。只有勇者才敢踏入。</string>
    <string name="dungeon_volcanic_depths_name">火山深渊</string>
    <string name="dungeon_volcanic_depths_desc">一个地狱犬和低阶恶魔栖息的灼热洞穴。酷热难耐！</string>
    <string name="dungeon_dragon_lair_name">龙巢</string>
    <string name="dungeon_dragon_lair_desc">绿龙传说中的栖息之地。只有大师级战士才能在此生还。</string>
    <string name="dungeon_farm_name">农场</string>
    <string name="dungeon_farm_desc">一座有家畜的宁静农场。非常适合新手收集食物！</string>
    <string name="dungeon_infernal_stronghold_name">地狱要塞</string>
    <string name="dungeon_infernal_stronghold_desc">一座烈火与硫磺的要塞，由恶魔和地狱犬统治。光是高温就能杀死毫无准备的人。</string>
    <string name="dungeon_ancient_temple_name">远古神殿</string>
    <string name="dungeon_ancient_temple_desc">一座由大陆最强生物把守的远古神殿。只有最强的战士才敢进入。</string>
    <string name="dungeon_void_rift_name">虚空裂隙</string>
    <string name="dungeon_void_rift_desc">现实中的裂缝，虚空生物从这里涌入凡间。</string>
    <string name="dungeon_frozen_citadel_name">冰封城堡</string>
    <string name="dungeon_frozen_citadel_desc">被冰川包裹的古老堡垒，守卫们在永恒的守望中冻结。</string>
    <string name="dungeon_abyssal_throne_name">深渊王座</string>
    <string name="dungeon_abyssal_throne_desc">已知世界的最深处，自远古以来一直由虚空领主统治。</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">太阳尖塔</string>
    <string name="dungeon_sunspire_desc">被至日裂开的太阳塔废墟，热灵从中涌入此区域。属于太阳尖塔至日活动。</string>
    <string name="dungeon_hollowfen_name">幽沼</string>
    <string name="dungeon_hollowfen_desc">古墓沉没的迷雾沼泽，收割亡灵在此游荡。属于暗潮收割活动。</string>
    <string name="dungeon_cloud_kingdom_name">云之王国</string>
    <string name="dungeon_cloud_kingdom_desc">云层之上的领域，通过攀爬传说中的豆茎到达。巨人游荡在巨大的浮空岛上，天空巨蟒穿梭于云层间，风暴小鬼闪烁着躁动的能量。见过它的人寥寥无几，能回来讲述的人更少。</string>
    <string name="dungeon_blightwood_name">枯萎之森</string>
    <string name="dungeon_blightwood_desc">幽沼深处的腐朽森林，暗潮收割最恐怖的存在聚集于此。属于暗潮收割活动。</string>

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">黑魔龙王</string>
    <string name="boss_king_black_dragon_desc">传说中的三头巨龙，令整个王国闻风丧胆。</string>
    <string name="boss_demon_lord_name">魔王</string>
    <string name="boss_demon_lord_desc">来自深渊的远古恶魔，黑暗魔法的大师。</string>
    <string name="boss_kraken_name">海妖</string>
    <string name="boss_kraken_desc">深海的恐怖，巨大的海怪。</string>
    <string name="boss_balrog_name">炎魔</string>
    <string name="boss_balrog_desc">火焰与暗影的远古恶魔，从地底深处苏醒。</string>
    <string name="boss_void_sovereign_name">虚空君主</string>
    <string name="boss_void_sovereign_desc">虚空裂隙背后的原初实体，古老得无法估量，以蔑视的眼光看待凡间的挑战者。</string>
    <string name="boss_sol_invictus_name">索尔·因维克图斯，碎裂之焰</string>
    <string name="boss_sol_invictus_desc">太阳的碎片，从太阳尖塔废墟中脱落。只有最勇敢的战士才敢靠近。</string>
    <string name="boss_the_hollow_king_name">虚无之王</string>
    <string name="boss_the_hollow_king_desc">暗潮收割的无头君主，从枯萎之森骑出，收割活人所种之物。</string>
    <string name="boss_the_vault_guardian_name">宝库守卫</string>
    <string name="boss_the_vault_guardian_desc">由活金铸造的巨像，被永恒之火点燃而苏醒。只有大纪念碑的赞助者才能面对它。</string>
    <string name="boss_obsidian_colossus_name">黑曜石巨像</string>
    <string name="boss_obsidian_colossus_desc">一座迸发狂怒的大山。没有哪位孤胆英雄，能在它身上凿出超越一道伤痕的印记。组队来挑战。</string>
    <string name="boss_brood_empress_name">虫巢女皇</string>
    <string name="boss_brood_empress_desc">群星之间的虫群之母。她的子嗣曾覆灭万千大军，你会为此付足代价。</string>
    <string name="boss_the_world_ender_name">噬世者</string>
    <string name="boss_the_world_ender_desc">此物一动，诸国便要写下遗书。契约之上需刻下四个名字，否则将无人生还。</string>

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">坍塌矿井</string>
    <string name="dungeon_collapsed_mine_desc">铜矿下方的巨大洞穴。洞穴巨魔和岩石魔像出没于废墟之间，巨型蜘蛛在坍塌的矿道中织满蛛网。</string>
    <string name="dungeon_shadow_den_name">暗影巢穴</string>
    <string name="dungeon_shadow_den_desc">该地区盗贼公会使用的地下密室网络。盗贼、刺客和暗影生物潜伏在每个角落。</string>
    <string name="dungeon_abyssal_ruins_name">深渊废墟</string>
    <string name="dungeon_abyssal_ruins_desc">同时存在于凡间之上和之下的远古废墟。奇异的深渊生物在现实中时隐时现。</string>
    <string name="dungeon_ancient_forest_ruins_name">远古森林废墟</string>
    <string name="dungeon_ancient_forest_ruins_desc">被原始森林吞噬的石质废墟，如今被野性生物和德鲁伊的复仇之灵所占据。</string>
    <string name="dungeon_ancient_forge_name">远古锻造厂</string>
    <string name="dungeon_ancient_forge_desc">一座燃烧了数百年未曾熄灭的巨大矮人锻造厂。火焰元素和锻造守卫守护着它的秘密。</string>
    <string name="dungeon_arcane_ruins_name">奥术废墟</string>
    <string name="dungeon_arcane_ruins_desc">一座被摧毁的法师塔中仍在运作的地下密室。魔法构装体和附魔守卫仍在其中巡逻。</string>
    <string name="dungeon_corrupted_sanctum_name">腐化圣所</string>
    <string name="dungeon_corrupted_sanctum_desc">位于腐化林冠深处的阴暗圣所。暗黑祭司和腐化野兽守护着一个远古邪物。</string>
    <string name="dungeon_drowned_temple_name">沉没神殿</string>
    <string name="dungeon_drowned_temple_desc">海窟下方一座沉入海底的神殿，殿堂中灌满了海水，海洋生物已将其据为家园。</string>
    <string name="dungeon_rogue_sanctum_name">盗贼圣所</string>
    <string name="dungeon_rogue_sanctum_desc">公会内部的庇护所，只有经过考验的成员才能进入。</string>
    <string name="dungeon_guild_of_shadows_name">暗影公会</string>
    <string name="dungeon_guild_of_shadows_desc">盗贼公会最深处的圣地，由最精锐的执法者守卫。</string>
</resources>
