    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">Jaskinia Chochlików</string>
    <string name="dungeon_imp_cavern_desc">Płytka jaskinia pełna psotnych chochlików. Idealna dla zupełnie początkujących!</string>
    <string name="dungeon_goblin_cave_name">Jaskinia Goblinów</string>
    <string name="dungeon_goblin_cave_desc">Mroczna jaskinia zamieszkana przez gobliny i wielkie szczury. Dobre miejsce treningowe dla nowych poszukiwaczy przygód.</string>
    <string name="dungeon_spider_den_name">Nora Pająków</string>
    <string name="dungeon_spider_den_desc">Pełna pajęczyn jaskinia roi się od jadowitych pająków. Zabierz odtrutkę!</string>
    <string name="dungeon_bandit_camp_name">Obóz Bandytów</string>
    <string name="dungeon_bandit_camp_desc">Kryjówka złodziei i łotrzyków na pustkowiu. Miej oko na swoją sakiewkę!</string>
    <string name="dungeon_undead_crypt_name">Krypta Nieumarłych</string>
    <string name="dungeon_undead_crypt_desc">Starożytne miejsce pochówku, gdzie zmarli nie chcą spocząć w spokoju. Strzeż się mrocznej magii!</string>
    <string name="dungeon_fortress_ruins_name">Ruiny Fortecy</string>
    <string name="dungeon_fortress_ruins_desc">Rozpadające się pozostałości starożytnego zamku, strzeżone teraz przez rycerzy i żołnierzy.</string>
    <string name="dungeon_orc_stronghold_name">Twierdza Orków</string>
    <string name="dungeon_orc_stronghold_desc">Ufortyfikowana osada orków głęboko w górach. Tylko odważni ważą się tam wejść.</string>
    <string name="dungeon_volcanic_depths_name">Wulkaniczne Głębiny</string>
    <string name="dungeon_volcanic_depths_desc">Rozpalona jaskinia zamieszkana przez piekielne ogary i pomniejsze demony. Upał jest nie do zniesienia!</string>
    <string name="dungeon_dragon_lair_name">Legowisko Smoka</string>
    <string name="dungeon_dragon_lair_desc">Legendarna siedziba zielonych smoków. Tylko mistrzowie wojownicy przetrwają to wyzwanie.</string>
    <string name="dungeon_farm_name">Farma</string>
    <string name="dungeon_farm_desc">Spokojna farma z inwentarzem żywym. Świetna dla początkujących szukających jedzenia!</string>
    <string name="dungeon_infernal_stronghold_name">Piekielna Twierdza</string>
    <string name="dungeon_infernal_stronghold_desc">Twierdza ognia i siarki, rządzona przez demony i piekielne ogary. Sam upał może zabić nieprzygotowanych.</string>
    <string name="dungeon_ancient_temple_name">Starożytna Świątynia</string>
    <string name="dungeon_ancient_temple_desc">Starożytna świątynia strzeżona przez najpotężniejsze stworzenia w krainie. Tylko najsilniejsi wojownicy ważą się tam wejść.</string>
    <string name="dungeon_void_rift_name">Szczelina Pustki</string>
    <string name="dungeon_void_rift_desc">Rozdarcie w rzeczywistości, przez które istoty pustki wdzierają się do śmiertelnego świata.</string>
    <string name="dungeon_frozen_citadel_name">Zamarznięta Cytadela</string>
    <string name="dungeon_frozen_citadel_desc">Starożytna forteca zamknięta w lodowcu, jej obrońcy zamrożeni w wiecznej czujności.</string>
    <string name="dungeon_abyssal_throne_name">Otchłanny Tron</string>
    <string name="dungeon_abyssal_throne_desc">Najgłębszy punkt znanego świata, rządzony przez władców pustki od zarania dziejów.</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">The Sunspire</string> <!-- untranslated -->
    <string name="dungeon_sunspire_desc">A sun-tower ruin cracked open by the solstice, spilling heat spirits into the region. Part of the Sunspire Solstice event.</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_name">The Hollowfen</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_desc">A mist-drowned marsh of sunken barrows where the harvest dead walk. Part of the Gloomharvest event.</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_name">Cloud Kingdom</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_desc">A realm above the clouds, reached by climbing a legendary beanstalk. Giants roam vast floating islands, sky serpents drift between the cloudbanks, and storm imps crackle with restless energy. Few have seen it. Fewer still have returned to speak of it.</string> <!-- untranslated -->
    <string name="dungeon_blightwood_name">The Blightwood</string> <!-- untranslated -->
    <string name="dungeon_blightwood_desc">A rotting forest deep past the Hollowfen, where the Gloomharvest\'s strongest horrors gather. Part of the Gloomharvest event.</string> <!-- untranslated -->

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">Król Czarny Smok</string>
    <string name="boss_king_black_dragon_desc">Legendarny trójgłowy smok, budzący postrach w całym królestwie.</string>
    <string name="boss_demon_lord_name">Władca Demonów</string>
    <string name="boss_demon_lord_desc">Starożytny demon z otchłani, mistrz mrocznej magii.</string>
    <string name="boss_kraken_name">Kraken</string> <!-- untranslated -->
    <string name="boss_kraken_desc">Postrach głębokich mórz, kolosalny morski potwór.</string>
    <string name="boss_balrog_name">Gothic Ember</string> <!-- untranslated -->
    <string name="boss_balrog_desc">Starożytny demon płomienia i cienia, przebudzony ze snu głęboko pod ziemią.</string>
    <string name="boss_void_sovereign_name" translatable="false">The Void Sovereign</string> <!-- untranslated -->
    <string name="boss_void_sovereign_desc">Pierwotna istota stojąca za szczelinami pustki. Niewyobrażalnie stara, patrzy na śmiertelnych śmiałków z pogardą.</string>
    <string name="boss_sol_invictus_name">Sol Invictus, the Sundered Flame</string> <!-- untranslated -->
    <string name="boss_sol_invictus_desc">A shard of the sun itself, torn loose from the Sunspire ruin. Only the boldest warriors dare approach.</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_name">The Hollow King</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_desc">The headless sovereign of the Gloomharvest, riding out from the Blightwood to reap what the living have sown.</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_name">The Vault Guardian</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_desc">A colossus of living gold, woken by the lighting of the Eternal Flame. Only patrons of the Grand Monument may face it.</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_name">Obsidian Colossus</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_desc">A mountain given wrath. No lone hero has ever chipped more than a scar into it. Bring a party.</string> <!-- untranslated -->
    <string name="boss_brood_empress_name">Brood Empress</string> <!-- untranslated -->
    <string name="boss_brood_empress_desc">Mother of the swarm between the stars. Her brood has ended armies; yours had better be paid well.</string> <!-- untranslated -->
    <string name="boss_the_world_ender_name">The World Ender</string> <!-- untranslated -->
    <string name="boss_the_world_ender_desc">When it stirs, kingdoms write their wills. Four names on the contract or none return.</string> <!-- untranslated -->

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">Zawalona Kopalnia</string>
    <string name="dungeon_collapsed_mine_desc">Rozległa jaskinia pod kopalniami miedzi. Trolle jaskiniowe i golemy skalne nawiedzają gruzy, a wielkie pająki snują sieci w zawalonych szybach.</string>
    <string name="dungeon_shadow_den_name">Cieniste Legowisko</string>
    <string name="dungeon_shadow_den_desc">Sieć podziemnych komnat wykorzystywana przez miejscowy cech złodziei. Łotrzykowie, zabójcy i cieniste stworzenia czają się w każdym kącie.</string>
    <string name="dungeon_abyssal_ruins_name">Otchłanne Ruiny</string>
    <string name="dungeon_abyssal_ruins_desc">Starożytne ruiny istniejące jednocześnie nad i pod płaszczyzną śmiertelników. Dziwne otchłanne stworzenia przenikają do i z rzeczywistości.</string>
    <string name="dungeon_ancient_forest_ruins_name">Ruiny Starożytnego Lasu</string>
    <string name="dungeon_ancient_forest_ruins_desc">Kamienne ruiny pochłonięte przez pierwotny las, nawiedzane teraz przez dzikie stworzenia i mściwe duchy druidów.</string>
    <string name="dungeon_ancient_forge_name">Starożytna Kuźnia</string>
    <string name="dungeon_ancient_forge_desc">Rozległa krasnoludzka kuźnia, która płonie nieprzerwanie od wieków. Żywiołaki ognia i strażnicy kuźni chronią jej sekretów.</string>
    <string name="dungeon_arcane_ruins_name">Tajemne Ruiny</string>
    <string name="dungeon_arcane_ruins_desc">Wciąż czynne podziemne komnaty zniszczonej wieży czarodzieja. Magiczne konstrukty i zaklęci strażnicy wciąż patrolują jej korytarze.</string>
    <string name="dungeon_corrupted_sanctum_name">Skażone Sanktuarium</string>
    <string name="dungeon_corrupted_sanctum_desc">Spowite cieniem sanktuarium w sercu skażonego baldachimu lasu. Mroczni kapłani i skażone bestie strzegą starożytnego zła.</string>
    <string name="dungeon_drowned_temple_name">Zatopiona Świątynia</string>
    <string name="dungeon_drowned_temple_desc">Zatopiona świątynia pod morską grotą, której korytarze wypełnia woda i morskie stworzenia, które uczyniły z niej swój dom.</string>
    <string name="dungeon_rogue_sanctum_name">Sanktuarium Łotrów</string>
    <string name="dungeon_rogue_sanctum_desc">Wewnętrzne schronienie gildii, dostępne tylko dla sprawdzonych członków.</string>
    <string name="dungeon_guild_of_shadows_name">Gildia Cieni</string>
    <string name="dungeon_guild_of_shadows_desc">Najgłębsze sanktuarium gildii złodziei, strzeżone przez jej najbardziej elitarnych egzekutorów.</string>

